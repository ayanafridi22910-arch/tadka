# Copy this file to .env.local and fill in values.
# Supabase: https://supabase.com/dashboard → New Project → Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Razorpay (Phase: build-order step 4). Needs business KYC — flag it early!
# https://dashboard.razorpay.com — use Test keys first.
RAZORPAY_KEY_ID=your-test-key-id
RAZORPAY_KEY_SECRET=your-test-key-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret
